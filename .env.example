# ===== Server =====
PORT=8000
LOG_LEVEL=info
DATA_DIR=./data
# 只改变本地模拟商品；若 API 暴露到公网请设为 0
DEMO_SCENARIOS_ENABLED=1

# ===== LLM (OpenAI 兼容协议) =====
# 敏感项（LLM_BASE_URL / LLM_API_KEY）推荐通过环境变量注入：
#   export LLM_BASE_URL=<网关地址> LLM_API_KEY=<密钥>
# 环境变量优先于本文件；本文件仅作为本地开发兜底，已被 gitignore，勿提交真实密钥
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=qwen3-max

# ===== Embedding (OpenAI 兼容 /v1/embeddings，缺省复用 LLM_* 网关) =====
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4

# ===== 向量库 Qdrant（空 = qdrant-client 本地嵌入模式，落盘 DATA_DIR/qdrant） =====
# QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=globex_products

# ===== Hybrid Search（轻量 BM25 + 向量召回，经 RRF 融合） =====
PRODUCT_RECALL_TOP_N=30
HYBRID_SEARCH_ENABLED=1
HYBRID_RRF_K=60

# ===== CategoryInsight 低置信拒答阈值 =====
CATEGORY_KB_MIN_SCORE=0.35

# ===== Reranker（空 = 降级为按向量分排序，rerank_applied=false） =====
# RERANKER_BASE_URL=http://localhost:8081
# RERANKER_MODEL=BAAI/bge-reranker-base

# ===== Web 搜索 Tavily（空 = 不注册 web_search_tool） =====
# TAVILY_API_KEY=tvly-xxx

# ===== 可观测（空 = 不启用 TracingMiddleware） =====
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
